# ============================================================
# Atelier Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── MongoDB ──────────────────────────────────────────────────
# [REQUIRED] Your MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# [REQUIRED] Database name
# Your existing database is named "Atlier" — keep this value to preserve data.
DB_NAME=Atlier

# ── API Authentication ────────────────────────────────────────
# [REQUIRED] Secret key sent by the mobile app in the X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# ── OpenAI (NLP scheduling + voice transcription) ─────────────
# [REQUIRED FOR AI FEATURES]
# Previously named EMERGENT_LLM_KEY — copy the same key value here.
# Your key starts with sk-proj-...
OPENAI_API_KEY=

# [OPTIONAL] Override to use an OpenAI-compatible API (e.g. Azure OpenAI, Groq)
OPENAI_BASE_URL=

# ── Public URL ────────────────────────────────────────────────
# [REQUIRED] The public HTTPS URL of this backend (used in share links)
PUBLIC_BASE_URL=https://your-domain.com

# ── CORS ─────────────────────────────────────────────────────
# [OPTIONAL] Comma-separated list of allowed frontend origins.
# Leave empty during development — defaults to localhost:3000.
# Example: https://app.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=

# ── Gmail SMTP (email reminders + invoice notifications) ──────
# [OPTIONAL] Leave empty to use mock logging in development.
# Use a Gmail App Password (not your account password):
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# [OPTIONAL] Display name for outgoing emails. Defaults to "Atelier <GMAIL_USER>"
SENDER_EMAIL=

# ── Google Calendar (optional Meet link generation) ──────────
# [OPTIONAL] If not set, events fall back to randomly-generated mock Meet links.
# To configure: create OAuth2 credentials in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
